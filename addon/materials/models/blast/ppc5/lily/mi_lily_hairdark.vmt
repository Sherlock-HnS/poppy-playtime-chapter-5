"VertexlitGeneric"
{
    "$basetexture" "models\Blast\PPC5\lily\hair_d"
    "$bumpmap" "models\Blast\PPC5\lily\hair_n"

    "$alphatest" "1"

    "$alphatestreference" ".45"

